generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Brands from brands.json. Used to look up the currency for the cohort response.
model Brand {
  brandId  String @id @map("brand_id")
  currency String

  @@map("brands")
}

// Table A: raw purchase events. Only purchase events are ingested.
// event_id is the primary key, which is what makes re-ingestion idempotent.
model PurchaseEvent {
  eventId      String   @id @map("event_id")
  brandId      String   @map("brand_id")
  userId       String   @map("user_id")
  eventType    String   @map("event_type")
  customerType String   @map("customer_type")
  // timestamptz stores an absolute instant, so the local offset in the file is normalised to UTC
  receivedAt   DateTime @map("received_at") @db.Timestamptz(3)
  orderId      String   @map("order_id")
  amount       Decimal  @db.Decimal(12, 2)

  @@index([brandId, userId])
  @@map("purchase_events")
}

// Table B: one row per customer with the month they made their first purchase.
model CustomerCohort {
  brandId           String   @map("brand_id")
  userId            String   @map("user_id")
  firstOrderDate    DateTime @map("first_order_date") @db.Date
  acquisitionCohort DateTime @map("acquisition_cohort") @db.Date

  @@id([brandId, userId])
  @@index([brandId, acquisitionCohort])
  @@map("customer_cohorts")
}

// Table C: revenue per customer per calendar month (UTC).
model CustomerMonthlyRevenue {
  brandId          String   @map("brand_id")
  userId           String   @map("user_id")
  transactionMonth DateTime @map("transaction_month") @db.Date
  totalRevenue     Decimal  @map("total_revenue") @db.Decimal(14, 2)

  @@id([brandId, userId, transactionMonth])
  @@map("customer_monthly_revenue")
}

// Table D: revenue per brand, acquisition cohort and month gap. Read by the retention cohort API.
model CohortLtv {
  brandId           String   @map("brand_id")
  acquisitionCohort DateTime @map("acquisition_cohort") @db.Date
  monthGap          Int      @map("month_gap")
  totalRevenue      Decimal  @map("total_revenue") @db.Decimal(16, 2)

  @@id([brandId, acquisitionCohort, monthGap])
  @@map("cohort_ltv")
}
